@inproceedings{sun-etal-2026-lingua,
  selected = {true},
  title = {Lingua-Graph: A Unified Representation of Cross-Task Common Substructures for Analytic Language Processing},
  author = {Sun, Mingming and Jiang, Runze and Zhangchenxi, Zhu and Peng, Minlong and Cai, Yunfeng},
  booktitle = {Proceedings of the 64th Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers)},
  year = {2026},
  month = jul,
  pages = {24630--24646},
  address = {San Diego, California, United States},
  publisher = {Association for Computational Linguistics},
  doi = {10.18653/v1/2026.acl-long.1129},
  url = {https://aclanthology.org/2026.acl-long.1129/},
  code = {https://github.com/rudaoshi/Lingua},
  abstract = {Structural understanding of natural language requires explicit recovery of internal meaning structures (entities, facts, nested relations), yet current structural-analytic tasks are fragmented by inconsistent task requirements across datasets. We investigate the problem of robust cross-task structural understanding under heterogeneous requirements across structural-analytic tasks and outline a perspective called Analytic NLP in which tasks can be reformulated into a representation-then-decision paradigm. In this paper, we suggest a solution for the representation layer, called Lingua-Graph, which explicitly captures entities, facts, and relations. By representing predictions as explicit graphs with labeled nodes and edges, Lingua-Graph also improves interpretability, enabling transparent inspection and error analysis of intermediate meaning structures. We construct a labeled Lingua-Graph dataset and train a baseline parser. Experiments show that Lingua-Graph provides substantially higher entity-structure hostability than alternative representations on average, and OpenIE systems based on Lingua-Graph achieve superior performance on three benchmarks, demonstrating that better intermediate structures translate into downstream gains.},
  description = {A unified graph representation for cross-task analytic language processing and Open Information Extraction.},
  keywords = {Analytic NLP, Open Information Extraction, Structured Representation}
}

@misc{jiang2026contextaware,
  selected = {true},
  title = {From Context-Aware to Conflict-Aware: Generalizing Contrastive Decoding for Knowledge Conflict in LLMs},
  author = {Runze Jiang and Taiqiang Wu and Yan Wang and Bingyu Zhu and Longtao Huang},
  year = {2026},
  month = jun,
  journal = {arXiv preprint arXiv:2606.10298},
  eprint = {2606.10298},
  archivePrefix = {arXiv},
  primaryClass = {cs.AI},
  doi = {10.48550/arXiv.2606.10298},
  url = {https://arxiv.org/abs/2606.10298},
  code = {https://github.com/keith-Jiang/Conflict-Aware-Decoding},
  abstract = {When large language models generate from retrieved or augmented contexts, conflicts between external context and parametric priors remain a central reliability bottleneck. Existing contrastive decoding methods follow a context-aware paradigm that unilaterally amplifies context over parametric priors, overwriting correct priors when the context is erroneous. We generalize this to a conflict-aware paradigm that dynamically allocates authority between prior and context based on conflict signals, rather than presupposing context trustworthiness. We show that the affine combination of prior and context logits yields a power family with an inherent regime asymmetry: extrapolation amplifies errors unboundedly when the prior is correct, interpolation under-corrects when the context is correct, and no static regime covers both. Existing contrastive decoding methods are instances of this family, mostly extrapolative. To evaluate both conflict directions, we propose TriState-Bench, a model-aware evaluation protocol that calibrates per-model prior knowledge to measure three conflict states: correction, resistance, and agreement. To resolve the asymmetry, we propose Adaptive Regime Routing (ARR), which routes between regimes at each step, lifting resistance EM from below 6 to 16–33 without sacrificing correction or agreement.},
  description = {Conflict-aware contrastive decoding and adaptive regime routing for knowledge conflicts in LLMs.},
  keywords = {Large Language Models, Knowledge Conflict, Contrastive Decoding}
}

@misc{jiang2026weakness,
  selected = {true},
  title = {Weakness Localization Is Not Enough: State-Aware Recursive Knowledge Improvement for Large Language Models},
  author = {Runze Jiang and Yan Wang and Boran Jin and Bingyu Zhu and Longtao Huang},
  year = {2026},
  month = oct,
  journal = {arXiv preprint arXiv:2610.36811},
  eprint = {2610.36811},
  archivePrefix = {arXiv},
  primaryClass = {cs.CL},
  doi = {10.48550/arXiv.2610.36811},
  url = {https://arxiv.org/abs/2610.36811},
  abstract = {Knowledge improvement in large language models is shifting from predefined knowledge incorporation pipelines toward evaluation-guided updating. Existing methods use evaluation to localize model-specific knowledge weaknesses and guide targeted post-training. However, identifying what to improve does not necessarily provide sufficient information for deciding how to improve it. The same localized weakness can be compatible with distinct operational knowledge states: the relevant knowledge may be unavailable, available but difficult to access reliably, or accessible but ineffective for downstream use. We call this ambiguity knowledge-state aliasing. When compatible states favor different interventions, greater diagnostic resolution alone is insufficient for intervention selection. Moreover, model updates can change the underlying knowledge state before the observed weakness disappears, such that an intervention appropriate in one round may no longer address the bottleneck in the next. To address these challenges, we propose Recursive Knowledge Improvement (RKI), which formulates knowledge improvement as a sequential, state-aware intervention process. RKI organizes knowledge into graph-structured units that provide a shared basis for diagnostic evaluation and targeted intervention across rounds. At each round, RKI localizes knowledge weaknesses, estimates the model's operational knowledge state from diagnostic evidence and intervention history, selects a corresponding intervention, and re-evaluates the updated model before determining the next intervention. On HotpotEval and SafeInternalEval, RKI outperforms existing knowledge incorporation methods by 18.41 points on average. Further analyses show that knowledge states provide additional guidance for intervention selection beyond weakness localization and can change across model updates even when the observed weakness persists.},
  description = {State-aware recursive knowledge improvement through sequential diagnosis and targeted intervention.},
  keywords = {Large Language Models, Knowledge Improvement, State-Aware Intervention}
}
